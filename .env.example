# ==============================================================================
# PrivateMind Environment Configuration Template
# Duplicate this file as 'backend/.env' and populate with your local values.
# NEVER commit real API keys or secrets to version control.
# ==============================================================================

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Database Storage URL (defaults to backend/data/privatemind.db)
DATABASE_URL=sqlite:///./data/privatemind.db

# ------------------------------------------------------------------------------
# LLM Provider Configuration (Phase 5)
# Options for LLM_PROVIDER: 'mock', 'nebius', 'nvidia', 'openai'
# ------------------------------------------------------------------------------
LLM_PROVIDER=mock
LLM_TIMEOUT=30.0

# --- Option A: Nebius Token Inference ---
# LLM_PROVIDER=nebius
# NEBIUS_API_KEY=your_nebius_studio_api_key_here
# LLM_BASE_URL=https://api.studio.nebius.ai/v1
# LLM_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct

# --- Option B: NVIDIA NIM API Catalog ---
# LLM_PROVIDER=nvidia
# NVIDIA_API_KEY=your_nvidia_api_key_here
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=meta/llama-3.1-70b-instruct

# --- Option C: Custom OpenAI-Compatible Endpoint ---
# LLM_PROVIDER=openai
# LLM_API_KEY=your_api_key_here
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
